<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">
    <class name="Sylius\Bundle\Order_Bundle\Controller\Add_To_Cart_Command">
        <constraint name="Sylius\Bundle\Core_Bundle\Validator\Constraints\Cart_Item_Variant_Enabled">
            <option name="groups">
                <value>sylius</value>
            </option>
        </constraint>
        <constraint name="Sylius\Bundle\Core_Bundle\Validator\Constraints\Cart_Item_Availability">
            <option name="message">sylius.cart_item.not_available</option>
            <option name="groups">
                <value>sylius</value>
            </option>
        </constraint>
    </class>
</constraint-mapping>
